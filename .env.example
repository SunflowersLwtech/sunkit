# Data sources
# Required for the current source set: none.

# Recommended first: raises GitHub Search API limits and supports repo expansion.
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional later: only needed if we move beyond no-auth feeds/public APIs.
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=
PRODUCTHUNT_API_TOKEN=
HUGGINGFACE_TOKEN=
LIBRARIES_IO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
TWITTERAPI_IO_API_KEY=

# Douyin publishing via dreammis/social-auto-upload.
SOCIAL_AUTO_UPLOAD_ROOT=runtime/social-auto-upload
# Optional: set when the Douyin QR login has created cookies/douyin_<account>.json.
DOUYIN_ACCOUNT_NAME=
SOCIAL_UPLOAD_ACCOUNT_NAME=
# Optional: point at runtime/social-auto-upload/.venv/bin/sau after installing the uploader.
SOCIAL_AUTO_UPLOAD_CLI=
# Optional fallback for source checkout execution.
SOCIAL_AUTO_UPLOAD_PYTHON=
# Safety gate. Keep empty/0 for E2E contract checks; set 1 only for an intentional live upload.
SEARCHPO_DOUYIN_LIVE=0
# Live uploads default to headed browser mode so humans can handle Douyin verification prompts.
SOCIAL_UPLOAD_HEADED=

# E2E command tier. `contract` is local and safe-by-default; `provider`, `lambda`, and `live` are explicit.
SEARCHPO_E2E_PROFILE=contract
SEARCHPO_AGENT_MODE=contract
SEARCHPO_DOUYIN_CHECK_LEVEL=manifest

# Remotion rendering. `local` is the default; `lambda` uploads the site to S3 and invokes AWS Lambda.
SEARCHPO_REMOTION_RENDER_MODE=local
SEARCHPO_RENDERED_VIDEO=
SEARCHPO_REMOTION_PROPS=

# Optional later: five-dimensional LLM scoring / claim review.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SEARCHPO_DEEPSEEK_MODEL=deepseek-v4-pro
XAI_API_KEY=
GROK_API_KEY=
KIMI_API_KEY=
KIMI_CODE_API_KEY=

# Gemini / Google AI Platform.
# Runtime should export GOOGLE_API_KEY="$GOOGLE_AGENT_PLATFORM_API".
GOOGLE_AGENT_PLATFORM_API=
GOOGLE_API_KEY=
# `vertex_express` uses aiplatform.googleapis.com for Agent Platform / Vertex API keys.
# Use `developer` only for Google AI Studio keys that can call generativelanguage.googleapis.com.
SEARCHPO_GEMINI_API_MODE=vertex_express
SEARCHPO_GEMINI_VERTEX_PROJECT=
SEARCHPO_GEMINI_VERTEX_LOCATION=global
SEARCHPO_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Voice timbre. More expressive options: Puck (upbeat), Zephyr (bright), Aoede.
SEARCHPO_GEMINI_TTS_VOICE=Kore
# Emotion/delivery directive prepended to the TTS prompt (not spoken). Leave the
# default for an energetic tech-creator read; blank = flat bare-text TTS.
SEARCHPO_GEMINI_TTS_STYLE=
SEARCHPO_GEMINI_AUDIT_MODEL=gemini-3.5-flash
SEARCHPO_GEMINI_INLINE_VIDEO_MAX_BYTES=18874368
SEARCHPO_GEMINI_SCORER_MODEL=gemini-3.5-flash

# Content quality / multi-candidate mode.
# Set to 1 to generate 3 polish variants and pick highest-scoring.
SEARCHPO_POLISH_MULTI_CANDIDATE=0
# Target LUFS for voiceover normalization (requires ffmpeg).
SEARCHPO_AUDIO_TARGET_LUFS=-16
# Render quality (CRF 18 = high quality, 23 = default, lower = bigger file).
SEARCHPO_RENDER_CRF=18
SEARCHPO_RENDER_AUDIO_BITRATE=192K
# Video timing. With audio, durationInFrames = audio_frames + tail; FPS is fixed
# at 30. Without audio (contract runs), the default frame count is used.
SEARCHPO_VIDEO_FPS=30
SEARCHPO_VIDEO_TAIL_FRAMES=
SEARCHPO_DURATION_FRAMES=360
# Douyin hashtag limits (the # constraint). Tags are sanitized, de-duplicated
# and capped; topics longer than the per-tag cap are truncated.
SEARCHPO_DOUYIN_MAX_TAGS=5
SEARCHPO_DOUYIN_MAX_TAG_LEN=20

# Notifications (optional).
SEARCHPO_SLACK_WEBHOOK=
SEARCHPO_BARK_URL=

# Remotion Lambda.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=ap-southeast-1
REMOTION_LAMBDA_REGION=ap-southeast-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=searchpo-radar
REMOTION_LAMBDA_MEMORY_MB=2048
REMOTION_LAMBDA_TIMEOUT_SEC=120
REMOTION_LAMBDA_DISK_MB=10240
REMOTION_LAMBDA_CONCURRENCY=4
REMOTION_LAMBDA_PRIVACY=private
REMOTION_LAMBDA_DELETE_AFTER=7-days
