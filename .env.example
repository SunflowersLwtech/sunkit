# Phase 1 data sources
# Required for the current MVP source set: none.

# Recommended first: raises GitHub Search API limits and supports repo expansion.
GITHUB_TOKEN=

# Optional later: only needed if we move beyond no-auth feeds/public APIs.
PRODUCTHUNT_API_KEY=
PRODUCTHUNT_API_SECRET=
PRODUCTHUNT_API_TOKEN=
HUGGINGFACE_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=

# Optional later: five-dimensional LLM scoring / claim review.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Gemini / Google AI Platform.
# Runtime should export GOOGLE_API_KEY="$GOOGLE_AGENT_PLATFORM_API".
GOOGLE_AGENT_PLATFORM_API=
GOOGLE_API_KEY=

# Remotion Lambda.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=ap-southeast-1
REMOTION_LAMBDA_REGION=ap-southeast-1
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_MEMORY_MB=2048
REMOTION_LAMBDA_TIMEOUT_SEC=120
REMOTION_LAMBDA_DISK_MB=10240
REMOTION_LAMBDA_PRIVACY=private
REMOTION_LAMBDA_DELETE_AFTER=7-days
