{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchpo Douyin Upload Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "platform",
    "adapter",
    "run_id",
    "selected_candidate_id",
    "expected_video_path",
    "expected_video_sha256",
    "cover_path",
    "cover_sha256",
    "execution_profile",
    "side_effect_tier",
    "render_mode",
    "render_props_sha256",
    "publish_mode",
    "title",
    "desc",
    "tags",
    "live_upload_default",
    "live_upload_gate"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "integer"},
    "created_at": {"type": "string"},
    "manifest_status": {"type": "string"},
    "run_id": {"type": "string"},
    "selected_candidate_id": {"type": "string"},
    "platform": {"const": "douyin"},
    "adapter": {"type": "string"},
    "cli": {"type": "string"},
    "account_env": {"type": "array", "items": {"type": "string"}},
    "expected_video_path": {"type": "string"},
    "expected_video_sha256": {"type": ["string", "null"]},
    "expected_video_bytes": {"type": ["integer", "null"]},
    "cover_path": {"type": "string"},
    "cover_sha256": {"type": ["string", "null"]},
    "execution_profile": {"enum": ["contract", "provider", "lambda", "live"]},
    "side_effect_tier": {"enum": ["contract", "provider", "lambda", "live"]},
    "render_mode": {"enum": ["none", "local", "lambda"]},
    "publish_mode": {"enum": ["none", "contract-check", "live"]},
    "render_props_sha256": {"type": ["string", "null"]},
    "render_props_hash": {"type": ["string", "null"]},
    "render_payload_sha256": {"type": ["string", "null"]},
    "voiceover_sha256": {"type": ["string", "null"]},
    "captions_sha256": {"type": ["string", "null"]},
    "mp4_hash": {"type": ["string", "null"]},
    "cover_hash": {"type": ["string", "null"]},
    "publish_hash": {"type": ["string", "null"]},
    "title": {"type": "string", "minLength": 1},
    "desc": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}},
    "tags_raw": {"type": "array", "items": {"type": "string"}},
    "hashtag_string": {"type": "string"},
    "max_tags": {"type": "integer", "minimum": 1},
    "caption_preview": {"type": "string"},
    "live_upload_default": {"type": "boolean"},
    "live_upload_gate": {"type": "string"},
    "contract_path": {"type": "string"}
  }
}
