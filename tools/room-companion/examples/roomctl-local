#!/usr/bin/env python3
"""roomctl: control room-companion from the same machine (or any container on the host network).

  roomctl status
  roomctl video on|off   roomctl audio on|off   roomctl ai on|off   roomctl all on|off
  roomctl say "关视频和声音"        # same sentences as the voice command
  roomctl --source 手机 ...        # who asked, shown in the confirmation message
"""
import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("ROOM_COMPANION_URL", "http://127.0.0.1:8790")


def call(path, body=None):
    data = None if body is None else json.dumps(body, ensure_ascii=False).encode()
    req = urllib.request.Request(BASE + path, data=data, method="POST" if body is not None else "GET",
                                 headers={"Content-Type": "application/json", "X-Room-AI": "1"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return json.loads(e.read().decode() or "{}")


def main(argv):
    source = "命令行"
    if len(argv) >= 2 and argv[0] == "--source":
        source, argv = argv[1], argv[2:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "status":
        s = call("/api/status")
        print(s.get("summary", s))
        return 0
    if argv[0] == "say":
        r = call("/api/command", {"text": " ".join(argv[1:]), "source": source})
    elif argv[0] in ("video", "audio", "ai", "all") and len(argv) == 2 and argv[1] in ("on", "off"):
        v = argv[1] == "on"
        keys = ("video", "audio", "ai") if argv[0] == "all" else (argv[0],)
        r = call("/api/switch", {**{k: v for k in keys}, "source": source})
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    print(r.get("message") or r.get("summary") or json.dumps(r, ensure_ascii=False))
    return 0 if r.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
