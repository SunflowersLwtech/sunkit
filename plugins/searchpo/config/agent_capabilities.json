{
  "version": 1,
  "description": "Redacted capability routing for Searchpo agents. This file declares environment variable names only, never secret values.",
  "declared_env": [
    "ANTHROPIC_API_KEY",
    "ANYSEARCH_API_KEY",
    "AWS_BEDROCK_API_KEY",
    "BLUESKY_APP_PASSWORD",
    "BLUESKY_HANDLE",
    "CARTESIA_API_KEY",
    "CONTEXT7_API_KEY",
    "DEEPSEEK_API_KEY",
    "DOUYIN_ACCOUNT_NAME",
    "EXA_API_KEY",
    "FIRECRAWL_API_KEY",
    "GH_TOKEN",
    "GITHUB_PERSONAL_ACCESS_TOKEN",
    "GITHUB_TOKEN",
    "GITLAB_PERSONAL_ACCESS_TOKEN_MAC0107",
    "GITLAB_TOKEN",
    "GOOGLE_AGENT_PLATFORM_API",
    "GOOGLE_API_KEY",
    "GROK_API_KEY",
    "HUGGINGFACE_TOKEN",
    "KIMI_API_KEY",
    "KIMI_CODE_API_KEY",
    "LIBRARIES_IO_API_KEY",
    "OPENAI_API_KEY",
    "PRODUCTHUNT_API_KEY",
    "PRODUCTHUNT_API_SECRET",
    "PRODUCTHUNT_API_TOKEN",
    "REDDIT_CLIENT_ID",
    "REDDIT_CLIENT_SECRET",
    "REMOTION_AWS_ACCESS_KEY_ID",
    "REMOTION_AWS_REGION",
    "REMOTION_AWS_SECRET_ACCESS_KEY",
    "REMOTION_LAMBDA_BUCKET_NAME",
    "REMOTION_LAMBDA_CONCURRENCY",
    "REMOTION_LAMBDA_DELETE_AFTER",
    "REMOTION_LAMBDA_DISK_MB",
    "REMOTION_LAMBDA_FUNCTION_NAME",
    "REMOTION_LAMBDA_MEMORY_MB",
    "REMOTION_LAMBDA_PRIVACY",
    "REMOTION_LAMBDA_REGION",
    "REMOTION_LAMBDA_SITE_NAME",
    "REMOTION_LAMBDA_TIMEOUT_SEC",
    "SEARCHPO_AGENT_MODE",
    "SEARCHPO_AUDIO_TARGET_LUFS",
    "SEARCHPO_BARK_URL",
    "SEARCHPO_CARTESIA_MODEL",
    "SEARCHPO_CARTESIA_VOICE",
    "SEARCHPO_DEEPSEEK_MODEL",
    "SEARCHPO_DOUYIN_CHECK_LEVEL",
    "SEARCHPO_DOUYIN_LIVE",
    "SEARCHPO_DOUYIN_MAX_TAGS",
    "SEARCHPO_DOUYIN_MAX_TAG_LEN",
    "SEARCHPO_DOUYIN_UPLOADER",
    "SEARCHPO_DOUYIN_VISIBILITY",
    "SEARCHPO_DURATION_FRAMES",
    "SEARCHPO_E2E_PROFILE",
    "SEARCHPO_EGO_PUBLISHER",
    "SEARCHPO_GEMINI_API_MODE",
    "SEARCHPO_GEMINI_AUDIT_MODEL",
    "SEARCHPO_GEMINI_INLINE_VIDEO_MAX_BYTES",
    "SEARCHPO_GEMINI_SCORER_MODEL",
    "SEARCHPO_GEMINI_TTS_AUDIO_ENCODING",
    "SEARCHPO_GEMINI_TTS_MODEL",
    "SEARCHPO_GEMINI_TTS_SAMPLE_RATE_HZ",
    "SEARCHPO_GEMINI_TTS_SPEED",
    "SEARCHPO_GEMINI_TTS_STYLE",
    "SEARCHPO_GEMINI_TTS_VOICE",
    "SEARCHPO_GEMINI_TTS_VOLUME_GAIN_DB",
    "SEARCHPO_GEMINI_VERTEX_LOCATION",
    "SEARCHPO_GEMINI_VERTEX_PROJECT",
    "SEARCHPO_LLM_API_KEY",
    "SEARCHPO_LLM_MODEL",
    "SEARCHPO_LLM_SCORER_MODEL",
    "SEARCHPO_LLM_URL",
    "SEARCHPO_POLISH_MULTI_CANDIDATE",
    "SEARCHPO_REMOTION_PROPS",
    "SEARCHPO_REMOTION_RENDER_MODE",
    "SEARCHPO_RENDERED_VIDEO",
    "SEARCHPO_RENDER_AUDIO_BITRATE",
    "SEARCHPO_RENDER_CRF",
    "SEARCHPO_SLACK_WEBHOOK",
    "SEARCHPO_TTS_DAILY_CHARS",
    "SEARCHPO_TTS_LEDGER",
    "SEARCHPO_TTS_PROVIDER",
    "SEARCHPO_VIDEO_FPS",
    "SEARCHPO_VIDEO_TAIL_FRAMES",
    "SEARCHPO_VISUAL_AUDIT",
    "SOCIAL_AUTO_UPLOAD_CLI",
    "SOCIAL_AUTO_UPLOAD_PYTHON",
    "SOCIAL_AUTO_UPLOAD_ROOT",
    "SOCIAL_UPLOAD_ACCOUNT_NAME",
    "SOCIAL_UPLOAD_HEADED",
    "SOURCEGRAPH_PAT",
    "TINYFISH_API_KEY",
    "TWITTERAPI_IO_API_KEY",
    "TWITTERAPI_IO_USER_ID",
    "XAI_API_KEY",
    "X_BEARER_TOKEN",
    "X_CONSUMER_KEY",
    "X_CONSUMER_SECRET"
  ],
  "mcp_servers": {
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp",
      "owner_agent": "searchpo-research-agent",
      "skill": "searchpo-deepwiki-research",
      "tools": [
        "read_wiki_structure",
        "read_wiki_contents",
        "ask_question"
      ]
    }
  },
  "capabilities": [
    {
      "id": "deepwiki-repo-context",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "repo", "all"],
      "kind": "mcp",
      "mcp_server": "deepwiki",
      "env": [],
      "purpose": "Use DeepWiki MCP for GitHub repository structure, module explanations, and repo-specific Q&A before drafting repo-focused content.",
      "must_not": [
        "Do not treat DeepWiki as the only evidence source for publishable claims.",
        "Do not call generate_wiki unless the user explicitly asks for wiki generation."
      ]
    },
    {
      "id": "github-source-access",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "repo", "all"],
      "kind": "api",
      "env": ["GITHUB_TOKEN", "GH_TOKEN", "GITHUB_PERSONAL_ACCESS_TOKEN"],
      "required_any": ["GITHUB_TOKEN", "GH_TOKEN", "GITHUB_PERSONAL_ACCESS_TOKEN"],
      "purpose": "Raise GitHub API limits, fetch private/public repo metadata, README evidence, and issue/release context when available."
    },
    {
      "id": "gitlab-source-access",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "repo", "all"],
      "kind": "api",
      "env": ["GITLAB_PERSONAL_ACCESS_TOKEN_MAC0107", "GITLAB_TOKEN"],
      "purpose": "Fetch GitLab repository metadata or source context for non-GitHub repo inputs."
    },
    {
      "id": "code-context-search",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "repo", "all"],
      "kind": "api",
      "env": ["SOURCEGRAPH_PAT", "CONTEXT7_API_KEY"],
      "purpose": "Use code/documentation context services for dependency docs, repository references, and source-level corroboration."
    },
    {
      "id": "web-research-enrichment",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "paper", "repo", "topic", "all"],
      "kind": "api",
      "env": [
        "ANYSEARCH_API_KEY",
        "EXA_API_KEY",
        "FIRECRAWL_API_KEY",
        "TINYFISH_API_KEY",
        "LIBRARIES_IO_API_KEY",
        "PRODUCTHUNT_API_KEY",
        "PRODUCTHUNT_API_SECRET",
        "PRODUCTHUNT_API_TOKEN",
        "HUGGINGFACE_TOKEN",
        "REDDIT_CLIENT_ID",
        "REDDIT_CLIENT_SECRET"
      ],
      "purpose": "Expand source evidence beyond the canonical URL with search, extraction, package metrics, model-card context, Product Hunt data, or Reddit context when policy allows."
    },
    {
      "id": "agent-model-review",
      "owner_agent": "searchpo-main-agent",
      "profiles": ["review", "all"],
      "kind": "api",
      "env": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "XAI_API_KEY",
        "GROK_API_KEY",
        "KIMI_API_KEY",
        "KIMI_CODE_API_KEY",
        "AWS_BEDROCK_API_KEY"
      ],
      "purpose": "Reserve model-provider keys for secondary review, coding help, or cross-model critique; do not bypass the primary Searchpo provider scripts."
    },
    {
      "id": "deepseek-polish",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "provider", "all"],
      "kind": "script",
      "env": ["DEEPSEEK_API_KEY", "SEARCHPO_DEEPSEEK_MODEL", "SEARCHPO_POLISH_MULTI_CANDIDATE"],
      "required_all": ["DEEPSEEK_API_KEY"],
      "purpose": "Run `scripts/deepseek_polish.py` for voiceover polish and adaptive storyboard generation."
    },
    {
      "id": "gemini-media-quality",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "provider", "render", "all"],
      "kind": "script",
      "env": [
        "GOOGLE_AGENT_PLATFORM_API",
        "GOOGLE_API_KEY",
        "SEARCHPO_GEMINI_API_MODE",
        "SEARCHPO_GEMINI_VERTEX_PROJECT",
        "SEARCHPO_GEMINI_VERTEX_LOCATION",
        "SEARCHPO_GEMINI_TTS_MODEL",
        "SEARCHPO_GEMINI_TTS_VOICE",
        "SEARCHPO_GEMINI_TTS_AUDIO_ENCODING",
        "SEARCHPO_GEMINI_TTS_SAMPLE_RATE_HZ",
        "SEARCHPO_GEMINI_TTS_SPEED",
        "SEARCHPO_GEMINI_TTS_VOLUME_GAIN_DB",
        "SEARCHPO_GEMINI_TTS_STYLE",
        "SEARCHPO_GEMINI_AUDIT_MODEL",
        "SEARCHPO_GEMINI_INLINE_VIDEO_MAX_BYTES",
        "SEARCHPO_GEMINI_SCORER_MODEL",
        "SEARCHPO_AUDIO_TARGET_LUFS",
        "SEARCHPO_VISUAL_AUDIT"
      ],
      "required_any": ["GOOGLE_AGENT_PLATFORM_API", "GOOGLE_API_KEY"],
      "purpose": "Run Gemini content scoring, TTS, and visual audit scripts with the configured Searchpo model and voice parameters. SEARCHPO_VISUAL_AUDIT=deterministic skips the Gemini video audits and lets the deterministic audit decide the visual gate."
    },
    {
      "id": "llm-gateway-text",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "provider", "all"],
      "kind": "api",
      "env": ["SEARCHPO_LLM_URL", "SEARCHPO_LLM_API_KEY", "SEARCHPO_LLM_MODEL", "SEARCHPO_LLM_SCORER_MODEL"],
      "required_all": ["SEARCHPO_LLM_URL", "SEARCHPO_LLM_API_KEY", "SEARCHPO_LLM_MODEL"],
      "purpose": "Send copy polish and content scoring to an OpenAI-compatible chat/completions endpoint instead of DeepSeek and Gemini."
    },
    {
      "id": "cartesia-tts",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "provider", "all"],
      "kind": "script",
      "env": ["SEARCHPO_TTS_PROVIDER", "CARTESIA_API_KEY", "SEARCHPO_CARTESIA_VOICE", "SEARCHPO_CARTESIA_MODEL", "SEARCHPO_TTS_DAILY_CHARS", "SEARCHPO_TTS_LEDGER"],
      "required_all": ["CARTESIA_API_KEY", "SEARCHPO_CARTESIA_VOICE"],
      "purpose": "Run `scripts/cartesia_tts.py` for the voiceover when SEARCHPO_TTS_PROVIDER=cartesia, within the daily character cap."
    },
    {
      "id": "remotion-local-render",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "render", "all"],
      "kind": "script",
      "env": [
        "SEARCHPO_REMOTION_RENDER_MODE",
        "SEARCHPO_RENDERED_VIDEO",
        "SEARCHPO_REMOTION_PROPS",
        "SEARCHPO_RENDER_CRF",
        "SEARCHPO_RENDER_AUDIO_BITRATE",
        "SEARCHPO_VIDEO_FPS",
        "SEARCHPO_VIDEO_TAIL_FRAMES",
        "SEARCHPO_DURATION_FRAMES"
      ],
      "purpose": "Control local Remotion render inputs, quality, and timing."
    },
    {
      "id": "remotion-lambda-render",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "render", "lambda", "live", "all"],
      "kind": "script",
      "env": [
        "REMOTION_AWS_ACCESS_KEY_ID",
        "REMOTION_AWS_SECRET_ACCESS_KEY",
        "REMOTION_AWS_REGION",
        "REMOTION_LAMBDA_REGION",
        "REMOTION_LAMBDA_FUNCTION_NAME",
        "REMOTION_LAMBDA_BUCKET_NAME",
        "REMOTION_LAMBDA_SITE_NAME",
        "REMOTION_LAMBDA_MEMORY_MB",
        "REMOTION_LAMBDA_TIMEOUT_SEC",
        "REMOTION_LAMBDA_DISK_MB",
        "REMOTION_LAMBDA_CONCURRENCY",
        "REMOTION_LAMBDA_PRIVACY",
        "REMOTION_LAMBDA_DELETE_AFTER"
      ],
      "required_all": [
        "REMOTION_AWS_ACCESS_KEY_ID",
        "REMOTION_AWS_SECRET_ACCESS_KEY",
        "REMOTION_LAMBDA_REGION",
        "REMOTION_LAMBDA_FUNCTION_NAME",
        "REMOTION_LAMBDA_BUCKET_NAME"
      ],
      "purpose": "Run Remotion Lambda renders with private output and configured cleanup policy."
    },
    {
      "id": "douyin-publishing",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "publish", "live", "all"],
      "kind": "script",
      "env": [
        "SOCIAL_AUTO_UPLOAD_ROOT",
        "SOCIAL_AUTO_UPLOAD_PYTHON",
        "SOCIAL_AUTO_UPLOAD_CLI",
        "DOUYIN_ACCOUNT_NAME",
        "SOCIAL_UPLOAD_ACCOUNT_NAME",
        "SOCIAL_UPLOAD_HEADED",
        "SEARCHPO_DOUYIN_LIVE",
        "SEARCHPO_DOUYIN_CHECK_LEVEL",
        "SEARCHPO_DOUYIN_MAX_TAGS",
        "SEARCHPO_DOUYIN_MAX_TAG_LEN"
      ],
      "required_any": ["DOUYIN_ACCOUNT_NAME", "SOCIAL_UPLOAD_ACCOUNT_NAME"],
      "purpose": "Run Douyin adapter checks and live upload only after the main agent confirms an explicit current-run publish request."
    },
    {
      "id": "douyin-browser-publisher",
      "owner_agent": "searchpo-impl-agent",
      "profiles": ["implementation", "publish", "live", "all"],
      "kind": "script",
      "env": ["SEARCHPO_DOUYIN_UPLOADER", "SEARCHPO_EGO_PUBLISHER", "SEARCHPO_DOUYIN_VISIBILITY"],
      "required_all": ["SEARCHPO_EGO_PUBLISHER"],
      "purpose": "With SEARCHPO_DOUYIN_UPLOADER=ego, publish through a script that drives an already signed-in browser profile instead of social-auto-upload; live upload still needs an explicit current-run publish request."
    },
    {
      "id": "x-twitter-source-and-distribution",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "social", "all"],
      "kind": "api",
      "env": [
        "X_CONSUMER_KEY",
        "X_CONSUMER_SECRET",
        "X_BEARER_TOKEN",
        "TWITTERAPI_IO_USER_ID",
        "TWITTERAPI_IO_API_KEY"
      ],
      "purpose": "Use X/Twitter context as optional source or distribution data, not as the default Searchpo publish path."
    },
    {
      "id": "bluesky-source-and-distribution",
      "owner_agent": "searchpo-research-agent",
      "profiles": ["research", "social", "all"],
      "kind": "api",
      "env": ["BLUESKY_HANDLE", "BLUESKY_APP_PASSWORD"],
      "purpose": "Use Bluesky context or distribution credentials only when a workflow explicitly needs it."
    },
    {
      "id": "notifications",
      "owner_agent": "searchpo-main-agent",
      "profiles": ["notify", "all"],
      "kind": "webhook",
      "env": ["SEARCHPO_SLACK_WEBHOOK", "SEARCHPO_BARK_URL"],
      "purpose": "Send completion/failure notifications after the run artifacts and release gates are verified."
    },
    {
      "id": "command-profile-routing",
      "owner_agent": "searchpo-main-agent",
      "profiles": ["main", "all"],
      "kind": "runtime",
      "env": ["SEARCHPO_E2E_PROFILE", "SEARCHPO_AGENT_MODE", "SEARCHPO_DOUYIN_CHECK_LEVEL", "SEARCHPO_DOUYIN_LIVE"],
      "purpose": "Select safe contract/provider/lambda/live command tiers and enforce the live-publish safety boundary."
    }
  ]
}
