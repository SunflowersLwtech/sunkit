{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchpo ScenePlan",
  "type": "object",
  "required": ["schema_version", "scenes", "allowed_planning_scene_types"],
  "properties": {
    "schema_version": {"type": "number"},
    "service": {"const": "visual_planning"},
    "selected_candidate_id": {"type": ["string", "null"]},
    "allowed_planning_scene_types": {"type": "array", "items": {"type": "string"}},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "planning_type", "render_type", "visual_intent", "on_screen_text"],
        "properties": {
          "id": {"type": "string"},
          "planning_type": {"enum": ["hook", "context", "problem", "explanation", "evidence", "process", "timeline", "chart", "comparison", "quote", "summary", "cta"]},
          "render_type": {"type": "string"},
          "voiceover_ref": {"type": ["string", "null"]},
          "visual_intent": {"type": "string"},
          "on_screen_text": {"type": "object"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "timing_hint": {"type": "object"}
        }
      }
    }
  }
}
