{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Searchpo Premium Director Spec",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "knowledge_arc",
    "topic_objects",
    "visual_scenes",
    "motion_beats",
    "content_constraints"
  ],
  "properties": {
    "schema_version": {"type": "number"},
    "source": {"type": "string"},
    "profile": {
      "type": "object",
      "required": ["orientation", "aspect_ratio", "duration_seconds", "style_family", "motion_comfort"],
      "properties": {
        "orientation": {"enum": ["vertical", "horizontal"]},
        "aspect_ratio": {"enum": ["9:16", "16:9"]},
        "duration_seconds": {"type": "number", "minimum": 18},
        "style_family": {"type": "string"},
        "motion_comfort": {"type": "string"},
        "safe_space_px": {"type": "number"}
      },
      "additionalProperties": true
    },
    "knowledge_arc": {
      "type": "object",
      "required": [
        "hook",
        "mechanism",
        "architecture_position",
        "practical_fit",
        "failure_boundary",
        "judgment_framework"
      ],
      "properties": {
        "hook": {"type": "string"},
        "mechanism": {"type": "string"},
        "architecture_position": {"type": "string"},
        "practical_fit": {"type": "string"},
        "tradeoff": {"type": "string"},
        "failure_boundary": {"type": "string"},
        "judgment_framework": {"type": "string"},
        "takeaway": {"type": "string"}
      },
      "additionalProperties": true
    },
    "topic_objects": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "label": {"type": "string"},
          "detail": {"type": "string"},
          "source_ref": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "visual_scenes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "scene_type", "title", "objective", "motion_beats"],
        "properties": {
          "id": {"type": "string"},
          "scene_type": {
            "enum": [
              "HeroProblemScene",
              "MechanismExplodedView",
              "RepoFileTreeReveal",
              "ArchitectureFlowScene",
              "MetricComparisonScene",
              "DecisionMatrixScene",
              "TimelineBuildScene",
              "CodeOrTerminalScene",
              "KnowledgeTakeawayScene"
            ]
          },
          "kind": {
            "enum": [
              "HeroProblemScene",
              "MechanismExplodedView",
              "RepoFileTreeReveal",
              "ArchitectureFlowScene",
              "MetricComparisonScene",
              "DecisionMatrixScene",
              "TimelineBuildScene",
              "CodeOrTerminalScene",
              "KnowledgeTakeawayScene"
            ]
          },
          "title": {"type": "string"},
          "objective": {"type": "string"},
          "teaching_beats": {"type": "array", "items": {"type": "string"}},
          "object_refs": {"type": "array", "items": {"type": "string"}},
          "layout": {"type": "string"},
          "motion_beats": {
            "type": "array",
            "items": {
              "enum": [
                "reveal",
                "build",
                "pan",
                "camera_push",
                "camera_pan",
                "parallax",
                "mask_reveal",
                "morph",
                "path_draw",
                "metric_count",
                "typewriter",
                "object_focus",
                "dwell"
              ]
            }
          },
          "dwell_frames": {"type": "number"}
        },
        "additionalProperties": true
      }
    },
    "motion_beats": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["type", "target", "intensity"],
        "properties": {
          "type": {
            "enum": [
              "reveal",
              "build",
              "pan",
              "camera_push",
              "camera_pan",
              "parallax",
              "mask_reveal",
              "morph",
              "path_draw",
              "metric_count",
              "typewriter",
              "object_focus",
              "dwell"
            ]
          },
          "target": {"type": "string"},
          "intensity": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "content_constraints": {
      "type": "object",
      "properties": {
        "source_boundary": {"type": "string"},
        "knowledge_takeaway_required": {"type": "boolean"},
        "forbid_dismissive_verification_language": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
