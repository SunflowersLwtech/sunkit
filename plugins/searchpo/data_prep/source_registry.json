  "search_strategy": {
    "passes": [
      {
        "id": "native_pull",
        "goal": "Collect cheap source-native trending or latest items before expansion.",
        "target_raw_items": 50,
        "sources": [
          "github_trending",
          "github_search_ai_repos",
          "hacker_news_algolia",
          "product_hunt_feed",
          "devto_ai",
          "lobsters_ai",
          "exa_web_search",
          "huggingface_models",
          "libraries_io_search",
          "arxiv_ai_ml_cl",
          "v2ex_hot",
          "kr36_feed",
          "openai_news_rss"
        ]
      },
      {
        "id": "query_expansion",
        "goal": "Fill missing topic families only when capped native/query batches produce fewer than 30 viable normalized candidates.",
        "families": [
          "agent_workflow",
          "oss_infra",
          "demo_signal",
          "buyer_pain",
          "commercial_context"
        ]
      },
      {
        "id": "cross_source_validation",
        "goal": "Validate filtered candidates before strong claims enter scripting.",
        "minimum_evidence": "official source plus one independent discussion, demo/code artifact, public homepage/docs, or paper-code/model link"
      }
    ],
    "topic_families": {
      "agent_workflow": [
        "AI agent",
        "coding agent",
        "browser agent",
        "MCP",
        "workflow automation",
        "智能体",
        "自动化"
      ],
      "oss_infra": [
        "open source AI",
        "local LLM",
        "RAG",
        "evals",
        "observability",
        "开源",
        "本地大模型",
        "知识库"
      ],
      "demo_signal": [
        "demo",
        "playground",
        "try it",
        "live preview",
        "screenshot",
        "video",
        "演示",
        "试用"
      ],
      "buyer_pain": [
        "automate",
        "replace",
        "faster",
        "reduce cost",
        "self-hosted",
        "降本",
        "提效",
        "私有化"
      ],
      "commercial_context": [
        "SaaS",
        "API",
        "pricing",
        "launch",
        "beta",
        "融资",
        "企业服务"
      ]
    },
    "stop_rules": {
      "max_raw_items": 100,
      "target_surviving_candidates": 30,
      "shortlist_size": 20,
      "minimum_source_families_in_shortlist": 4,
      "stop_expansion_if_new_candidates_below": 3
    }
  },
