{
  "version": "2026-05-28.data-prep",
  "timezone": "Asia/Kuala_Lumpur",
  "default_collection_window_hours": 48,
  "sources": [
    {
      "id": "github_trending",
      "priority": "P0",
      "category": "oss_project",
      "role": "Fresh OSS repository discovery and repo-level metrics.",
      "fetch_method": "html",
      "primary_endpoint": "https://github.com/trending?since=daily&spoken_language_code=",
      "probe_url": "https://github.com/trending?since=daily&spoken_language_code=",
      "fallback_endpoint": "https://api.github.com/search/repositories",
      "auth": "optional_github_token",
      "schedule": "daily",
      "rate_policy": "Prefer one trending HTML request per run. Use Search API only for query expansion or fallback.",
      "queries": [
        "topic:ai created:>{date_minus_7d}",
        "topic:agents created:>{date_minus_14d}",
        "topic:llm created:>{date_minus_14d}",
        "topic:mcp created:>{date_minus_30d}",
        "topic:rag created:>{date_minus_30d}",
        "browser agent",
        "coding agent",
        "workflow automation"
      ],
      "extract_fields": [
        "repo_full_name",
        "url",
        "description",
        "language",
        "stars",
        "stars_today",
        "forks",
        "topics",
        "owner",
        "readme_url"
      ],
      "search_use": [
        "discover_new_repos",
        "verify_repo_metrics",
        "detect_demo_assets_from_readme"
      ],
      "preprocess": [
        "canonicalize_repo_url",
        "parse_owner_repo",
        "fetch_readme_for_top_candidates_only",
        "extract_demo_keywords_from_readme"
      ],
      "source_reliability": 0.85
    },
