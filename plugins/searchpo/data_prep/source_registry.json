      "probe_url": "https://api.github.com/search/repositories?q=topic:ai&sort=updated&order=desc&per_page=1",
      "auth": "optional_github_token",
      "schedule": "daily",
      "rate_policy": "Use repo search with SEARCHPO_MAX_QUERIES_PER_SOURCE capped query batches; prefer .env GitHub tokens for higher limits.",
      "queries": [
        "topic:ai created:>{date_minus_7d}",
        "topic:agents created:>{date_minus_14d}",
        "topic:llm created:>{date_minus_14d}",
        "topic:mcp created:>{date_minus_30d}",
        "topic:rag created:>{date_minus_30d}",
        "\"browser agent\"",
        "\"coding agent\"",
        "\"workflow automation\""
      ],
      "extract_fields": [
        "full_name",
        "html_url",
        "description",
        "language",
        "stargazers_count",
        "forks_count",
        "open_issues_count",
        "topics",
        "created_at",
        "pushed_at"
