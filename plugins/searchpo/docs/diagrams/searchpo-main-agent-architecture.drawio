        <mxCell id="61" value="Task board + state" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=13;" vertex="1" parent="60">
          <mxGeometry x="40" y="50" width="145" height="52" as="geometry" />
        </mxCell>
        <mxCell id="62" value="Evidence pack" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=13;" vertex="1" parent="60">
          <mxGeometry x="205" y="50" width="145" height="52" as="geometry" />
        </mxCell>
        <mxCell id="63" value="Media + audit identity" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=13;" vertex="1" parent="60">
          <mxGeometry x="370" y="50" width="145" height="52" as="geometry" />
        </mxCell>
        <mxCell id="64" value="Final truth" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;fontStyle=1;" vertex="1" parent="60">
          <mxGeometry x="535" y="50" width="105" height="52" as="geometry" />
        </mxCell>

        <mxCell id="70" value="Target Behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#111827;fontColor=#ffffff;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="985" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="71" value="Main asks for a meaningful video, not a fixed template. Research proves what can be said. Impl chooses duration, orientation, custom animation, and execution strategy. Main releases only when evidence, media, and publish truth agree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;fontColor=#ffffff;fontSize=14;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="90" y="1030" width="480" height="80" as="geometry" />
        </mxCell>

        <mxCell id="80" value="Non-Goals / Hard Boundaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontColor=#111827;fontSize=14;fontStyle=1;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1310" y="985" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="81" value="No mocks. No silent media. No fallback publish truth. No implementation before evidence sufficiency. No release decision by research or implementation agents." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fda4af;fontColor=#111827;fontSize=14;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1030" width="480" height="80" as="geometry" />
        </mxCell>

