<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.0.4">
  <diagram id="searchpo-main-agent-architecture" name="Main Agent Architecture">
    <mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Searchpo Ideal Agent Runtime" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="490" y="24" width="920" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="A high-ambition planning agent delegates evidence discovery and execution, then verifies artifact truth before release." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="470" y="70" width="960" height="30" as="geometry" />
        </mxCell>

        <mxCell id="10" value="1. Intent Intake" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9ca3af;fontStyle=1;fontSize=15;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="350" height="300" as="geometry" />
        </mxCell>
        <mxCell id="11" value="User gives a link, topic, or publish request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=13;spacing=10;" vertex="1" parent="10">
          <mxGeometry x="42" y="58" width="266" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Main converts intent into a run-scoped objective, success bar, and side-effect tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=13;spacing=10;" vertex="1" parent="10">
          <mxGeometry x="42" y="158" width="266" height="92" as="geometry" />
        </mxCell>

        <mxCell id="20" value="2. Main Agent: Task-Plan Owner" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;fontSize=15;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="860" height="380" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;b&gt;searchpo-main-agent&lt;/b&gt;&#xa;&#xa;Writes an ambitious task plan, not a checklist of scripts.&#xa;&#xa;Defines: topic angle, evidence bar, content depth, video ambition, release gates, and recovery path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;fontStyle=1;spacing=14;" vertex="1" parent="20">
          <mxGeometry x="40" y="62" width="350" height="210" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Planning Contract&#xa;&#xa;What must be true before copy, media, and publish may happen." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=13;spacing=10;" vertex="1" parent="20">
          <mxGeometry x="450" y="62" width="170" height="104" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Delegation Contract&#xa;&#xa;Who owns each task, what artifact proves completion, and which gate blocks progress." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=13;spacing=10;" vertex="1" parent="20">
          <mxGeometry x="650" y="62" width="170" height="132" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Verification Contract&#xa;&#xa;Main decides pass/fail from run artifacts, not from agent claims." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=13;spacing=10;" vertex="1" parent="20">
          <mxGeometry x="450" y="216" width="170" height="104" as="geometry" />
        </mxCell>
        <mxCell id="25" value="Recovery Contract&#xa;&#xa;Failed gates become targeted follow-up tasks, not silent fallbacks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#60a5fa;fontSize=13;spacing=10;" vertex="1" parent="20">
          <mxGeometry x="650" y="216" width="170" height="104" as="geometry" />
        </mxCell>

        <mxCell id="30" value="3. Research Agent Boundary" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;fontSize=15;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="70" y="560" width="520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="31" value="&lt;b&gt;searchpo-research-agent&lt;/b&gt;&#xa;&#xa;Owns source discovery and evidence sufficiency. It does not write publish copy, render media, or make release decisions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="30">
          <mxGeometry x="40" y="58" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Canonical Boundary&#xa;primary URL, repo/API/README, official docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=13;spacing=8;" vertex="1" parent="30">
          <mxGeometry x="40" y="202" width="130" height="86" as="geometry" />
        </mxCell>
        <mxCell id="33" value="Independent Search&#xa;AnySearch extracts, supplemental sources, contradictions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=13;spacing=8;" vertex="1" parent="30">
          <mxGeometry x="195" y="202" width="130" height="86" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Evidence Pack&#xa;facts, source map, topic brief, cross-check verdict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#86efac;fontSize=13;spacing=8;" vertex="1" parent="30">
          <mxGeometry x="350" y="202" width="130" height="86" as="geometry" />
        </mxCell>

        <mxCell id="40" value="4. Implementation Agent Boundary" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;fontStyle=1;fontSize=15;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="560" width="620" height="360" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;searchpo-impl-agent&lt;/b&gt;&#xa;&#xa;Owns provider calls, React/CSS authoring, Remotion execution, audits, and publish checks. It returns artifacts and gate status only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=14;fontStyle=1;spacing=12;" vertex="1" parent="40">
          <mxGeometry x="45" y="58" width="530" height="110" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Content + Visual Generation&#xa;long-form script, custom React/CSS, storyboard intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;fontSize=13;spacing=8;" vertex="1" parent="40">
          <mxGeometry x="45" y="198" width="170" height="100" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Execution Loop&#xa;TTS chunks, captions, render, repair, rerender" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;fontSize=13;spacing=8;" vertex="1" parent="40">
          <mxGeometry x="230" y="198" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="44" value="Delivery Evidence&#xa;media identity, visual audits, publish-check evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;fontSize=13;spacing=8;" vertex="1" parent="40">
          <mxGeometry x="405" y="198" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="50" value="Research Barrier" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="805" y="625" width="290" height="120" as="geometry" />
        </mxCell>
        <mxCell id="51" value="Implementation Loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="800" width="340" height="92" as="geometry" />
        </mxCell>
        <mxCell id="52" value="Release Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="805" y="965" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="60" value="Runtime Memory + Artifact Truth" style="swimlane;startSize=34;rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=15;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="610" y="1185" width="680" height="120" as="geometry" />
